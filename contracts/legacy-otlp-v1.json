{
  "contract_version": 1,
  "contract_id": "codex-monitor-python-otlp-baseline-v1",
  "implementation_under_test": "Python MonitorServer prototype",
  "fixture_origin": "fully-synthetic-hand-authored",
  "purpose": "Freeze the current OTLP HTTP response and allowlisted SQLite projection before the Rust receiver replaces the Python prototype.",
  "prototype_deviations": [
    "Successful application/json requests return a legacy JSON summary instead of an OTLP ExportLogsServiceResponse JSON object.",
    "Malformed application/x-protobuf requests return a JSON error response instead of a Protobuf error response.",
    "Responses to gzip requests are not gzip encoded.",
    "The prototype selects JSON when Content-Type contains the substring json and otherwise attempts Protobuf decoding; it does not strictly validate supported media types."
  ],
  "privacy": {
    "fixture_policy": "No captured logs, prompts, local paths, accounts, databases, UUIDs, or production identifiers. Test identifiers and sensitive sentinels use synthetic-* and example.invalid.",
    "synthetic_identifiers": [
      "synthetic-conversation-0001",
      "synthetic-thread-0001",
      "synthetic-conversation-metadata-0001",
      "synthetic-conversation-unknown-0001",
      "synthetic-thread-unknown-0001",
      "synthetic-response-0001"
    ],
    "forbidden_storage_markers": [
      "synthetic-response-0001",
      "synthetic-prompt-marker.example.invalid",
      "synthetic-response-marker.example.invalid",
      "synthetic-tool-arguments.example.invalid",
      "synthetic-tool-output.example.invalid",
      "synthetic-reasoning-summary.example.invalid",
      "synthetic-encrypted-reasoning.example.invalid",
      "synthetic-command.example.invalid",
      "synthetic-workspace-path.example.invalid",
      "synthetic-account-0001",
      "synthetic-user@example.invalid",
      "synthetic-api-key.example.invalid",
      "synthetic-cookie.example.invalid",
      "synthetic-auth-token.example.invalid",
      "synthetic-future-field.example.invalid",
      "synthetic-forbidden-unknown-wire.example.invalid",
      "synthetic-malformed-json.example.invalid",
      "synthetic-not-gzip.example.invalid"
    ]
  },
  "sqlite_allowlist": {
    "codex_token_events": [
      "id",
      "created_at",
      "received_at",
      "conversation_id",
      "thread_id",
      "model",
      "reasoning_effort",
