{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexMonitor",
  "mainBinaryName": "codex-monitor",
  "version": "0.1.0",
  "identifier": "dev.codexmonitor.desktop",
  "build": {
    "frontendDist": "../../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "CodexMonitor contributors",
    "homepage": "https://github.com/dragonknightk/CodexMonitor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 CodexMonitor contributors",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "category": "Utility",
    "shortDescription": "Private local monitoring for Codex token usage and reasoning alerts.",
    "longDescription": "CodexMonitor receives allowlisted Codex OpenTelemetry metadata on loopback, stores structured history locally, and presents an authenticated browser Dashboard.",
    "useLocalToolsDir": true,
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "skip"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
